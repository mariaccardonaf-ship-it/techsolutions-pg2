 clase anidada estática, no un constructor independiente. El constructor privado es correcto. Una solicitud válida requiere cliente y uno o más elementos. confirmar(total) guarda el total y cambia el estado una sola vez; TechSolutions coordina las validaciones. Los elementos se exponen solo para lectura. Antes de confirmar, el costo es provisional." style="shape=note;whiteSpace=wrap;html=0;size=15;fillColor=#fff9e8;strokeColor=#b9a775;fontColor=#172b3a;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="898.8" width="1000" height="127" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Adapter"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e0" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;endArrow=none;strokeColor=#475569;strokeWidth=1.2;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontColor=#334155;fontSize=11;startArrow=block;startFill=0;dashed=1;" edge="1" source="ProveedorTecnicos" target="LegacySupportAdapter" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="268" y="208.31999999999994"/><mxPoint x="268" y="247.13"/><mxPoint x="268" y="297.90999999999997"/><mxPoint x="268" y="340.89"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;endArrow=none;strokeColor=#475569;strokeWidth=1.2;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontColor=#334155;fontSize=11;" edge="1" source="LegacySupportAdapter" target="LegacySupport" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="268" y="517.54"/><mxPoint x="268" y="550.61"/><mxPoint x="268" y="587.1899999999999"/><mxPoint x="268" y="616.05"/></Array></mxGeometry></mxCell><mxCell id="e2" v