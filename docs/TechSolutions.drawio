8b;fontColor=#172b3a;fontSize=12;fontStyle=1;fontFamily=Arial;whiteSpace=nowrap;overflow=hidden;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="1512.5" y="430.59999999999997" width="210" height="106" as="geometry"/></mxCell><mxCell id="DisponibilidadTecnica" value="DisponibilidadTecnica" style="swimlane;html=1;startSize=32;horizontal=1;rounded=0;fillColor=#e8eef5;swimlaneFillColor=#ffffff;strokeColor=#64748b;fontColor=#172b3a;fontSize=12;fontStyle=1;fontFamily=Arial;whiteSpace=nowrap;overflow=hidden;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="1841.5" y="438.59999999999997" width="210" height="90" as="geometry"/></mxCell><mxCell id="reglas_modelo" value="Confirmación: reunir especialidades en List sin repetir; consultar una vez por especialidad. Si falta disponibilidad, mantener REGISTRADA. Calcular como máximo un desplazamiento por especialidad. Domicilio ($25.000) se suma como complemento; no incluye desplazamiento de LegacySupport. No acumular cargos al repetir cálculos. Una solicitud CONFIRMADA conserva su total. Bloquear recursivamente paquetes contratados antes de cerrar la confirmación. GeneradorCodigos garantiza códigos durante una ejecución; comprobar unicidad al registrar." style="shape=note;whiteSpace=wrap;html=0;size=15;fillColor=#fff9e8;strokeColor=#b9a775;fontColor=#172b3a;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="940.8" width="1000" height="173" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mvc-javafx" name="MVC JavaFX"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="App_attrs" value="" style="shape=rectangle;html=1;fillColor=#ffffff;strokeColor=#64748b;align=left;verticalAlign=top;fontSize=12;spacing=10;overflow=hidden;" vertex="1" connectable="0" parent="App"><mxGeometry x="0" y="55" width="400" height="14" as="geometry"/></mxCell><mxCell i